# ============================================
# Dockerfile de Produção - Chatwoot Customizado
# ============================================
# Este Dockerfile constrói uma imagem customizada do Chatwoot
# com suas modificações de frontend mantidas

# Estágio 1: Build do Frontend
FROM node:20-bookworm-slim AS frontend-builder

# Instalar dependências do sistema
RUN apt-get update && apt-get install -y \
    git \
    python3 \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copiar arquivos de dependências primeiro (cache layer)
COPY package.json pnpm-lock.yaml ./

# Instalar pnpm e dependências
RUN npm install -g pnpm@latest
RUN pnpm install --frozen-lockfile

# Copiar código fonte (incluindo suas customizações)
COPY . .

# Build do frontend em produção
ENV NODE_ENV=production
ENV RAILS_ENV=production
RUN pnpm build

# ============================================
# Estágio 2: Imagem de Produção
# ============================================
FROM ruby:3.3-slim-bookworm

# Argumentos de build
ARG RAILS_ENV=production
ARG BUNDLE_WITHOUT="development:test"

ENV RAILS_ENV=${RAILS_ENV}
ENV NODE_ENV=production
ENV BUNDLE_WITHOUT=${BUNDLE_WITHOUT}

# Instalar dependências do sistema para produção
RUN apt-get update && apt-get install -y \
    libpq-dev \
    postgresql-client \
    git \
    curl \
    wget \
    build-essential \
    shared-mime-info \
    tzdata \
    imagemagick \
    libvips-dev \
    && rm -rf /var/lib/apt/lists/*

# Instalar Node.js 20
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g pnpm@latest

WORKDIR /app

# Copiar Gemfile primeiro (cache layer)
COPY Gemfile Gemfile.lock ./

# Instalar gems
RUN gem install bundler && \
    bundle config set --local deployment 'true' && \
    bundle config set --local without ${BUNDLE_WITHOUT} && \
    bundle install -j "$(nproc)"

# Copiar código da aplicação
COPY . .

# Copiar assets compilados do estágio de build do frontend
COPY --from=frontend-builder /app/public/packs ./public/packs

# Criar usuário não-root para segurança
RUN groupadd -r chatwoot && \
    useradd -r -g chatwoot -d /app -s /sbin/nologin chatwoot && \
    chown -R chatwoot:chatwoot /app

# Criar diretórios necessários
RUN mkdir -p /app/tmp/pids /app/tmp/cache /app/tmp/sockets /app/log /app/public/packs && \
    chown -R chatwoot:chatwoot /app/tmp /app/log /app/public

USER chatwoot

# Expor porta 3000
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

# Entrypoint e comando
ENTRYPOINT ["docker/entrypoints/rails.sh"]
CMD ["bundle", "exec", "rails", "s", "-p", "3000", "-b", "0.0.0.0"]
